# Leave FLYTE_BACKEND_URL empty to run in mock mode: no keys needed, every
# fare, payment and booking is simulated.

# --- Live mode (server only, never exposed to the browser) ---
# The Flyte AI API and this deployment's connection settings. Take these from
# your Flyte AI deployment.
FLYTE_BACKEND_URL=
FLYTE_API_ROUTES=
FLYTE_API_KEY=
FLYTE_API_KEY_HEADER=
FLYTE_CLIENT_IP_HEADER=

# --- Live mode (public, safe in the browser) ---
# PayPal REST app client id. Client ids are public; secrets never live here.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# sandbox (default) or production
NEXT_PUBLIC_PAYPAL_ENV=sandbox

# --- Voice (server only; works in mock mode too) ---
# ElevenLabs API key. Without it the browser's own speech is used where available.
ELEVENLABS_API_KEY=
# Kiwi by default.
ELEVENLABS_VOICE_ID=VEWZvLXUrFL3O7dUnBSW
# ElevenLabs' ultra-low-latency model by default.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# false switches voice off for everyone.
ELEVENLABS_VOICE_ENABLED=true

# --- Media (server only) ---
# Origin the demo videos live on (a CDN); the site serves them under /media.
# Unset hides the video section.
MEDIA_ORIGIN=
